FRONTEND_URL=http://localhost:3100
BACKEND_URL=http://localhost:8100
ALLOW_LOCAL_LOGIN=true
# Optional GitHub OAuth app: callback http://localhost:8100/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave empty to generate and persist a random session secret in .state/.
SESSION_SECRET=
# API and benchmarks load backend/pipeline_profiles.json. Qwen3 is restricted
# to component/junction crops; full-page circuit generation is not used.
S2SDN_PIPELINE_PROFILE=hybrid_max_accuracy
IMAGE_MODE=hybrid_max_accuracy
# Optional native paths (not required in Docker):
# KICAD_CLI=/Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
# KICAD_SYMBOL_DIR=/Applications/KiCad/KiCad.app/Contents/SharedSupport/symbols
# Optional existing CUDA OCR environment, independent of KiCad's Python.
# S2SDN_OCR_PYTHON=D:/path/to/gpu-venv/Scripts/python.exe
# S2SDN_OCR_DEVICE=cuda
# CPU mode stays available; CUDA mode rejects a silent CPU downgrade.
# S2SDN_OCR_DEVICE=cpu
# Local vision service. Start with docker compose --profile vision up -d.
OLLAMA_URL=http://vision:11434
VISION_MODEL=qwen3-vl:2b-instruct
# For a separate local service, set VISION_OLLAMA_URL to its base URL.
# VISION_OLLAMA_URL=http://localhost:11434
# VISION_API_PROTOCOL=openai  # for a local OpenAI-compatible server instead of Ollama
# Large pages: overview plus up to four overlapping detail views in one request.
# VISION_IMAGE_SIZE=2048
# VISION_DETAIL_IMAGES=4
# VISION_CONTEXT_TOKENS=8192  # Ollama image context; keep chat's smaller context
# VISION_MAX_TOKENS=4096     # both vision protocols; truncated results are rejected
# Optional conversational model, e.g. qwen2.5:7b
CHAT_MODEL=
# Optional cloud chat for the design assistant (explanations and circuit planning only; schematic
# recognition always runs locally). OFF unless CHAT_API_URL and a key are set. Requests then leave this
# computer: NVIDIA's free endpoint logs them under its trial terms - do not send confidential designs.
# On any cloud failure the local model (CHAT_MODEL via OLLAMA_URL) answers instead.
# CHAT_API_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=
# CHAT_API_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# CHAT_API_TIMEOUT_SECONDS=60
# CHAT_API_MAX_TOKENS=2048
