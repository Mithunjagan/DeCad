# Copy to backend/.env on a new checkout, then replace the install paths.
# This is the strict CUDA profile from backend/pipeline_profiles.json.
S2SDN_KICAD_DIR=D:/KICAD
# OrCAD_ROOT is the parent of tools/, not tools/ itself.
ORCAD_ROOT=D:/
S2SDN_OCR_PYTHON=D:/path/to/DeCad/backend/.state/gpu-venv/Scripts/python.exe
ALLOW_LOCAL_LOGIN=true
# The production profile owns IMAGE_MODE, S2SDN_OCR_DEVICE, and S2SDN_TEXT_MODEL.
# Do not put tokens or private API keys in this checked-in example.
